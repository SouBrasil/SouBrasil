{
  "name": "TransactionType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do tipo de lan\u00e7amento"
    },
    "color": {
      "type": "string",
      "description": "Cor da categoria (hex ou tailwind)"
    },
    "icon_name": {
      "type": "string",
      "description": "Nome do \u00edcone Lucide"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "active": {
      "type": "boolean",
