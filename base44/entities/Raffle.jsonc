{
  "name": "Raffle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do sorteio"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "prize": {
      "type": "string",
      "description": "Pr\u00eamio"
    },
    "prize_type": {
      "type": "string",
      "enum": [
        "produto",
        "servico",
        "voucher",
        "dinheiro",
        "viagem",
        "desconto",
        "outro"
      ],
      "default": "produto"
    },
    "image_url": {
      "type": "string"
    },
    "draw_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "ativo",
        "realizado",
        "cancelado"
      ],
      "default": "rascunho"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "todos",
        "premium",
        "premium_anual",
        "premium_mensal",
        "trial",
        "parceiros"
      ],
      "default": "todos"
    },
    "filter_city": {
      "type": "string"
    },
    "filter_state": {
      "type": "string"
    },
    "filter_radius_km": {
      "type": "number"
    },
    "partner_id": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "max_participants": {
      "type": "number"
    },
    "unlimited_participants": {
      "type": "boolean",
      "default": true
    },
    "automatic_draw": {
      "type": "boolean",
      "default": false
    },
    "winner_user_email": {
      "type": "string"
    },
    "winner_user_name": {
      "type": "string"
    },
    "redemption_conditions": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "partner_request_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "prize",
    "draw_date"
  ]
}