{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "Email de quem indicou"
    },
    "referral_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de indica\u00e7\u00e3o"
    },
    "referral_type": {
      "type": "string",
      "enum": [
        "cliente",
        "parceiro"
      ],
      "description": "Tipo de indica\u00e7\u00e3o"
    },
    "total_referrals": {
      "type": "number",
      "default": 0,
      "description": "Total de indica\u00e7\u00f5es realizadas"
    },
    "total_earnings": {
      "type": "number",
      "default": 0,
      "description": "Total ganho em reais"
    },
    "pending_earnings": {
      "type": "number",
      "default": 0,
      "description": "Ganhos pendentes"
    }
  },
  "required": [
    "referrer_email",
    "referral_code",
    "referral_type"
  ]
}