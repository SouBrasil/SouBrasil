{
  "name": "ReferralConversion",
  "type": "object",
  "properties": {
    "referral_code": {
      "type": "string",
      "description": "C\u00f3digo de indica\u00e7\u00e3o usado"
    },
    "referrer_email": {
      "type": "string",
      "description": "Email de quem indicou"
    },
    "referred_email": {
      "type": "string",
      "description": "Email de quem foi indicado"
    },
    "referral_type": {
      "type": "string",
      "enum": [
        "cliente",
        "parceiro"
      ],
      "description": "Tipo de indica\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status do pagamento"
    },
    "earnings": {
      "type": "number",
      "default": 10,
      "description": "Valor ganho (R$ 10 por indica\u00e7\u00e3o)"
    },
    "converted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da convers\u00e3o"
    }
  },
  "required": [
    "referral_code",
    "referrer_email",
    "referred_email",
    "referral_type"
  ]
}