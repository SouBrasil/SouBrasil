{
  "name": "PushNotificationOrder",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "radius_km": {
      "type": "number",
      "default": 10
    },
    "credits_remaining": {
      "type": "number"
    },
    "asaas_payment_id": {
      "type": "string",
      "description": "ID do pagamento no Asaas"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente_pagamento",
        "pago",
        "cancelado"
      ],
      "default": "pendente_pagamento"
    }
  },
  "required": [
    "partner_id",
    "quantity",
    "total_price"
  ]
}