{
  "name": "CarouselBanner",
  "type": "object",
  "properties": {
    "carousel_type": {
      "type": "string",
      "enum": [
        "home_banner",
        "action_button"
      ],
      "description": "Tipo: banner principal ou bot\u00e3o de a\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo exibido no banner"
    },
    "subtitle": {
      "type": "string",
      "description": "Subt\u00edtulo ou descri\u00e7\u00e3o curta"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem de fundo"
    },
    "link_url": {
      "type": "string",
      "description": "URL ou rota ao clicar (ex: /Pricing, https://...)"
    },
    "badge_text": {
      "type": "string",
      "description": "Texto do badge (ex: 20% OFF)"
    },
    "gradient_from": {
      "type": "string",
      "description": "Cor inicial do gradiente (hex ou tailwind, para action buttons)"
    },
    "gradient_to": {
      "type": "string",
      "description": "Cor final do gradiente"
    },
    "icon_name": {
      "type": "string",
      "description": "Nome do \u00edcone Lucide para action buttons"
    },
    "image_height": {
      "type": "number",
      "default": 192,
      "description": "Altura do banner em pixels (home_banner)"
    },
    "image_fit": {
      "type": "string",
      "enum": [
        "cover",
        "contain",
        "fill"
      ],
      "default": "cover",
      "description": "Como a imagem se ajusta ao container"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o (menor = primeiro)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativo e vis\u00edvel no app"
    },
    "open_external": {
      "type": "boolean",
      "default": false,
      "description": "Abrir link em nova aba (URLs externas)"
    }
  },
  "required": [
    "carousel_type",
    "title"
  ]
}